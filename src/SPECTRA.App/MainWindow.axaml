<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SPECTRA.App.Platforms"
        x:Class="SPECTRA.App.MainWindow"
        Title="SPECTRA"
        Width="1440" Height="980"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#20212A"
        Foreground="#E8E3EA"
        KeyDown="OnWindowKeyDown">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#45414F"/>
      <Setter Property="Foreground" Value="#E8E3EA"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#A9B59C"/>
      <Setter Property="Foreground" Value="#2B2C37"/>
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="#353641"/>
      <Setter Property="Foreground" Value="#DDD7E1"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#594047"/>
      <Setter Property="Foreground" Value="#E6B8B5"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#2B2C37"/>
      <Setter Property="BorderBrush" Value="#494A57"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#2B2C37"/>
      <Setter Property="BorderBrush" Value="#494A57"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#E8E3EA"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Styles>

  <Grid Margin="22" RowDefinitions="Auto,*" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="SPECTRA" FontSize="28" FontWeight="Bold" LetterSpacing="2"/>
          <Border Background="#48404F" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
            <TextBlock Text="PREVIEW" FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
          </Border>
        </StackPanel>
        <TextBlock Text="Quest display, directly in your desktop workspace." Foreground="#A9A5B2" FontSize="13"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#2B2C37" BorderBrush="#41424F" BorderThickness="1"
              CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Fill="{Binding ConnectionDotBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ConnectionSummary}" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,350" ColumnSpacing="22">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="Live preview" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding QualityDescription}" FontSize="12" Foreground="#A9A5B2"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Fullscreen" Classes="subtle" Click="OnFullscreenClick"/>
        </Grid>

        <Border Grid.Row="1" Background="#20212A" BorderThickness="0"
                CornerRadius="0" ClipToBounds="True" MinHeight="400">
          <Grid x:Name="PreviewArea">
            <Border x:Name="VideoFrame" Width="800" Height="450"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#151515" BorderThickness="0" CornerRadius="0" ClipToBounds="True">
              <local:ScrcpyVideoHost x:Name="VideoHost"/>
            </Border>
            <Border IsVisible="{Binding IsVideoPlaceholderVisible}" Background="#292A35">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="13" MaxWidth="400">
                <Border Width="70" Height="70" CornerRadius="35" Background="#49424F">
                  <TextBlock Text="◉" FontSize="31" Foreground="#C2B6D0"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Your Quest display will appear here" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Connect a headset, then start the stream. Video is embedded in this window."
                           FontSize="12" Foreground="#A9A5B2" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="#2B2C37" BorderBrush="#41424F" BorderThickness="1"
                CornerRadius="12" Padding="16,12">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" FontSize="13"/>
              <TextBlock Text="{Binding ActivityMessage}" FontSize="11" Foreground="#A9A5B2"
                         TextWrapping="Wrap" MaxHeight="44"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh devices" Classes="subtle"
                    Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding CanRefreshDevices}"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Start stream" Classes="primary"
                    Command="{Binding StartStreamingCommand}" IsEnabled="{Binding CanStartStream}"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Stop stream" Classes="danger"
                    Command="{Binding StopStreamingCommand}" IsVisible="{Binding IsStreaming}"
                    IsEnabled="{Binding CanStopStream}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <Border Background="#2B2C37" BorderBrush="#41424F" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Device" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DeviceStateText}" Foreground="#A9A5B2" FontSize="12"/>
              </StackPanel>
              <TextBlock Text="ADB device" FontSize="11" Foreground="#A9A5B2"/>
              <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                        IsEnabled="{Binding CanChooseDevice}" MinHeight="38">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <TextBlock Text="{Binding Serial}" FontWeight="Medium"/>
                      <TextBlock Text="{Binding State}" Foreground="#A9A5B2" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="USB: connect the headset and accept the debugging prompt. Refresh to rescan."
                         TextWrapping="Wrap" FontSize="11" Foreground="#A9A5B2"/>
            </StackPanel>
          </Border>

          <Border Background="#2B2C37" BorderBrush="#41424F" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel Spacing="11">
              <StackPanel Spacing="3">
                <TextBlock Text="Wireless debugging" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Pair once, then connect with the device endpoint." FontSize="11"
                           Foreground="#A9A5B2" TextWrapping="Wrap"/>
              </StackPanel>
              <CheckBox Content="Automatically reconnect to saved Wi-Fi device"
                        IsChecked="{Binding AutoConnectWifi}" IsEnabled="{Binding CanChooseDevice}"/>
              <TextBlock Text="Pairing address (host:port)" FontSize="11" Foreground="#A9A5B2"/>
              <TextBox Text="{Binding PairingEndpoint}" Watermark="192.168.1.20:37123"
                       IsEnabled="{Binding CanChooseDevice}"/>
              <TextBlock Text="Pairing code" FontSize="11" Foreground="#A9A5B2"/>
              <TextBox Text="{Binding PairingCode}" Watermark="Code shown in Quest"
                       IsEnabled="{Binding CanChooseDevice}"/>
              <Button Content="Pair headset" Command="{Binding PairWirelessCommand}"
                      IsEnabled="{Binding CanChooseDevice}" HorizontalAlignment="Stretch"/>
              <Border Height="1" Background="#45434F" Margin="0,2"/>
              <TextBlock Text="Device address (host:port)" FontSize="11" Foreground="#A9A5B2"/>
              <TextBox Text="{Binding DeviceEndpoint}" Watermark="192.168.1.20:5555"
                       IsEnabled="{Binding CanChooseDevice}"/>
              <Button Content="Connect over Wi-Fi" Classes="subtle"
                      Command="{Binding ConnectWirelessCommand}" IsEnabled="{Binding CanChooseDevice}"
                      HorizontalAlignment="Stretch"/>
              <TextBlock Text="In Quest, enable Developer mode and Wireless debugging. The pairing port and connection port are different; enter each as shown in the headset."
                         FontSize="11" Foreground="#A9A5B2" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="#2B2C37" BorderBrush="#41424F" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="Stream quality" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Changes apply to the next stream. Stop streaming to edit quality."
                           FontSize="11" Foreground="#A9A5B2" TextWrapping="Wrap"/>
              </StackPanel>
              <CheckBox Content="Automatic quality (recommended)"
                        IsChecked="{Binding IsAutomaticQuality}" IsEnabled="{Binding CanEditQuality}"/>
              <StackPanel Spacing="6" Opacity="{Binding ManualQualityOpacity}">
                <TextBlock Text="Maximum resolution" FontSize="11" Foreground="#A9A5B2"/>
                <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}"
                          IsEnabled="{Binding CanEditQualityAndManualQuality}"/>
                <TextBlock Text="Frames per second" FontSize="11" Foreground="#A9A5B2"/>
                <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFps}"
                          IsEnabled="{Binding CanEditQualityAndManualQuality}"/>
                <TextBlock Text="Video bitrate (Mbps)" FontSize="11" Foreground="#A9A5B2"/>
                <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding SelectedBitrateMbps}"
                          IsEnabled="{Binding CanEditQualityAndManualQuality}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#2B2C37" BorderBrush="#41424F" BorderThickness="1" CornerRadius="14" Padding="18">
            <StackPanel Spacing="11">
              <StackPanel Spacing="3">
                <TextBlock Text="Video framing" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Show one lens only. Changes apply to the next stream."
                           FontSize="11" Foreground="#A9A5B2" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="Eye" FontSize="11" Foreground="#A9A5B2"/>
              <TextBlock Text="Default alignment: left +22° · right −22° (independent settings)"
                         FontSize="10" Foreground="#A9A5B2" TextWrapping="Wrap"/>
              <ComboBox ItemsSource="{Binding EyeOptions}" SelectedItem="{Binding SelectedEye}"
                        IsEnabled="{Binding CanEditVideo}" MinHeight="38"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Rotation" FontSize="11" Foreground="#A9A5B2"/>
                <TextBlock Grid.Column="1" Text="{Binding RotationDescription}"
                           FontSize="12" FontWeight="SemiBold"/>
              </Grid>
              <Slider Minimum="-180" Maximum="180" TickFrequency="1"
                      Value="{Binding RotationDegrees}" IsEnabled="{Binding CanEditVideo}"/>
              <Grid ColumnDefinitions="*,*,*">
                <TextBlock Text="-180°" FontSize="10" Foreground="#A9A5B2"/>
                <TextBlock Grid.Column="1" Text="0°" FontSize="10" Foreground="#A9A5B2"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="+180°" FontSize="10" Foreground="#A9A5B2"
                           HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Audio is not included in this version." FontSize="11"
                     Foreground="#A9A5B2" TextWrapping="Wrap" Margin="2,0,2,8"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

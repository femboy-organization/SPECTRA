<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="releaseVersion" required="true" />
    <parameter name="fileVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="SPECTRA-${releaseVersion}-Setup-win-x64.exe"
      product-name="SPECTRA"
      product-version="${fileVersion}"
      file-version="${fileVersion}">
      <authenticode-sign hash-algorithm="sha256" description="SPECTRA Windows installer" />
    </pe-file>
  </zip-file>
</artifact-configuration>
